# Discord account linking (OAuth2 identify)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Staff channel webhook — Discord link reviews + new tickets (Accept/Reject are signed links)
DISCORD_STAFF_WEBHOOK_URL=
# Optional bot for Discord DMs when staff reply
DISCORD_BOT_TOKEN=
# Comma-separated SteamID64s that can reply as staff on tickets
STAFF_STEAM_IDS=
DEV_DISCORD_USERNAME=rustify_dev
DEV_DISCORD_ID=

LIVE_DATA_PROVIDER=mock
# stripe (default). mock is local-only and blocked in production.
PAYMENT_PROVIDER=stripe

# Stripe Checkout — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Production webhook endpoint: POST /api/webhooks/payment (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Oxide/Carbon plugin polls this with GAME_API_SECRET to apply VIP / Queue Skip by SteamID64
GAME_API_SECRET=dev-game-api-secret

# Optional BattleMetrics mapping when LIVE_DATA_PROVIDER=battlemetrics
